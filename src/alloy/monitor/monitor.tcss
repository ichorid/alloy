Screen {
    background: #0a0d12;
}

#stats {
    background: #12161d;
    border: round #2a3038;
    border-title-color: #79c0ff;
}

#limits {
    background: #12161d;
    border: round #2a3038;
    border-title-color: #79c0ff;
}

#runs {
    background: #12161d;
    border: round #2a3038;
    border-title-color: #79c0ff;
}

#runs .datatable--cursor {
    background: #1b2533;
}

#detail {
    background: #12161d;
    border: round #2a3038;
    border-title-color: #79c0ff;
}

Footer {
    background: #12161d;
    color: #79c0ff;
}

FooterKey .footer-key--key {
    color: #0a0d12;
    background: #79c0ff;
}

FooterKey .footer-key--description {
    color: #79c0ff;
    background: #12161d;
}
