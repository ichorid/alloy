.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# IDE / agent tooling state
.serena/

# local launcher
.alloy-run.sh

# not a locked project; agents running `uv` in worktrees leave this behind
uv.lock

# pytest/uv scratch dirs left in worktrees by sandboxed agent runs
.tmp/

# Alloy project state; .alloy/project.md and .alloy/recipes/ remain trackable
.alloy/*.db-*
.alloy/logs/
.alloy/worktrees/
.alloy/events.jsonl
.alloy/scheduler.pid
.alloy/scheduler.json
.alloy/scheduler.log
